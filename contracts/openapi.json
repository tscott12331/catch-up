          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "title": "Messages",
            "type": "array"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryIdentity"
          },
          "selected_file": {
            "title": "Selected File",
            "type": "string"
          },
          "starter_questions": {
            "items": {
              "type": "string"
            },
            "title": "Starter Questions",
            "type": "array"
          },
          "tree": {
            "items": {
              "$ref": "#/components/schemas/TreeNode"
            },
            "title": "Tree",
            "type": "array"
          }
        },
        "required": [
          "repository",
          "tree",
          "selected_file",
          "starter_questions",
          "messages",
          "job"
        ],
        "title": "WorkspaceResponse",
        "type": "object"
      }
    }
