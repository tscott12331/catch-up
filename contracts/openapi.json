            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "progress"
        ],
        "title": "IndexingJob",
        "type": "object"
      },
      "RepositoryCreateResponse": {
        "properties": {
          "job": {
            "$ref": "#/components/schemas/IndexingJob"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryIdentity"
          }
        },
        "required": [
          "repository",
          "job"
