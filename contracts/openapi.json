            "type": "string"
          },
          "repository_id": {
            "default": "",
            "title": "Repository Id",
            "type": "string"
          }
        },
        "title": "ChatRequest",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "end_line": {
            "title": "End Line",
            "type": "integer"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "start_line": {
            "title": "Start Line",
            "type": "integer"
          }
        },
        "required": [
          "file",
          "start_line",
          "end_line"
        ],
        "title": "Citation",
        "type": "object"
      },
      "FileResponse": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "title": "FileResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IndexingJob": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
