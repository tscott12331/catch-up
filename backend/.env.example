# Copy to backend/.env only if your shell loads dotenv files; otherwise export these variables.
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_JOB_DURATION_SECONDS=1.2
# Host-process connection string for the PostgreSQL service in compose.yaml.
DATABASE_URL=postgresql+psycopg://catch_up:catch_up@localhost:5432/catch_up
